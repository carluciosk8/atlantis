{
    "version": 4,
    "env": {
        "msxgl": "${workspaceFolder}/../MSXgl"
    },
    "configurations": [
        {
            "name": "MSXgl (SDCC Z80)",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/src",
                "${msxgl}/engine/src",
                "${msxgl}/engine/content",
                "${msxgl}/tools/sdcc/include/z80",
                "${msxgl}/tools/sdcc/include"
            ],
            "defines": [
                "__SDCC",
                "__SDCC_z80",
                "__SDCC_VERSION_MAJOR=4",
                "__SDCC_VERSION_MINOR=6",
                "__SDCC_VERSION_PATCH=0",
                "TARGET=TARGET_ROM_32K",
                "ROM_SIZE=32",
                "MSX_VERSION=MSX_1",
                "__sfr=volatile unsigned char",
                "__at(x)=",
                "__naked=",
                "__critical=",
                "__interrupt(x)=",
                "__sdcccall(x)=",
                "__banked=",
                "__reentrant=",
                "__asm=",
                "__endasm=",
                "__data=",
                "__code=",
                "__xdata=",
                "__near=",
                "__far=",
                "__z88dk_fastcall=",
                "__z88dk_callee=",
                "__preserves_regs(...)=",
                "__sbit=",
                "__using(x)=",
                "__nonbanked=",
                "__smallc=",
                "__trap="
            ],
            "compilerPath": "",
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${msxgl}/engine/src"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "enableConfigurationSquiggles": false
}
